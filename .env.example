# NEXT_PUBLIC_* se inyecta en tiempo de build: en Coolify, marcarlas como build variables.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Enlaces de descarga de la extensión (https). Si una queda vacía, ese navegador muestra "Próximamente".
NEXT_PUBLIC_EXT_URL_CHROME=
NEXT_PUBLIC_EXT_URL_FIREFOX=
NEXT_PUBLIC_EXT_URL_SAFARI=

# Piloto: .zip para instalación manual en Chrome, Edge y Brave (https o ruta "/..." de esta app).
# Solo se usa mientras NEXT_PUBLIC_EXT_URL_CHROME esté vacía.
NEXT_PUBLIC_EXT_ZIP_CHROME=/descargas/scamshield-extension-0.1.2-chrome.zip
# Versión vigente de la extensión, se muestra a quien la instaló a mano.
NEXT_PUBLIC_EXT_VERSION=0.1.2
